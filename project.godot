; Engine configuration file.
; FakeGods - vertical slice prototype for Godot 4.

config_version=5

[application]

config/name="FakeGods"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/description="Roguelike de acción: asciende hacia el cielo, derrota dioses y vuelve al templo para mejorar."

[autoload]

RunData="*res://scripts/run_data.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.11, 1)
